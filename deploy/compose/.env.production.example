# PLACEHOLDERS ONLY. A production environment example for the `prod` image variant
# (`docker build --target prod .`). Never put a real value in this file, and never commit one.
#
# Deliver real values through the host's secret mechanism (an orchestrator secret, a secret
# manager, an env file outside the repository), not through this file. The Compose stack in this
# directory is the development stack: it builds the dev image and sets TETHER_ENV=dev. It is not
# a production deployment.
# See docs/operations/production-configuration.md.

# Explicit, always. The prod image refuses to start when this is absent or not dev/test/prod.
TETHER_ENV=prod

# The scripted provider is refused in prod. Name the real provider and its model; there is no
# default model.
TETHER_MODEL_PROVIDER=openai
TETHER_OPENAI_MODEL=<model-name-chosen-by-the-operator>
TETHER_OPENAI_API_KEY=<provider-api-key-from-the-secret-store>

# Least-privilege application role (no DDL, no DELETE) used by api and worker.
TETHER_DATABASE_URL=postgresql://tether_app:<app-role-password>@<postgres-host>:5432/tether

# Migrator role: used only by `tether migrate` and `tether bootstrap apply`, never by api/worker.
TETHER_MIGRATOR_DATABASE_URL=postgresql://tether_migrator:<migrator-role-password>@<postgres-host>:5432/tether

# Path inside the container of the reviewed bootstrap file the operator mounts. The image holds
# none: public keys and API-key hashes only, never a private key.
TETHER_BOOTSTRAP_FILE=/etc/tether/bootstrap.yaml

# Audit-chain and call-binding keys (ADR-0010, ADR-0015): two separate families, never the same
# material. Each key is 32 random bytes, base64url, per key ID.
TETHER_AUDIT_ACTIVE_KEY_ID=<audit-key-id>
TETHER_AUDIT_KEY_<audit-key-id>=<32-random-bytes-base64url>
TETHER_BINDING_ACTIVE_KEY_ID=<binding-key-id>
TETHER_BINDING_KEY_<binding-key-id>=<32-random-bytes-base64url>

# Deliberate values (decision D-8); the numbers are examples, not recommendations.
TETHER_RUN_MAX_DURATION_SECONDS=<seconds>
TETHER_APPROVAL_TTL_SECONDS=<seconds>
# Upper bound for the default above and every policy rule's `approval_expiry_seconds`; a value
# above it is refused at `tether bootstrap apply` and at worker startup, never clamped.
TETHER_APPROVAL_MAX_TTL_SECONDS=<seconds>

# Optional: OTLP/HTTP collector base URL. Telemetry is best-effort.
TETHER_OTEL_ENDPOINT=
TETHER_LOG_LEVEL=INFO

# Deliberately absent: TETHER_SCENARIOS_DIR (the scripted provider's scenarios do not exist in
# this image) and any dev identity setting.

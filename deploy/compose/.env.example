# Copy to deploy/compose/.env (gitignored) and replace every value before first start.
# Docker Compose reads deploy/compose/.env automatically; `uv run poe test-integration` loads it too.
# Use URL-safe passwords (letters, digits, - and _): they are embedded in database URLs.

# Postgres superuser (used only by the postgres container's first-boot init).
TETHER_POSTGRES_PASSWORD=change-me-superuser

# Owner of the tether/langgraph schemas; used only by the migrate service.
TETHER_MIGRATOR_DB_PASSWORD=change-me-migrator

# Least-privilege role used by api and worker (no DDL).
TETHER_APP_DB_PASSWORD=change-me-app

# Model pulled by the `ollama-pull` service (`live` profile only). Chosen at S6.3 (PQ-3).
TETHER_OLLAMA_MODEL=

# Audit-chain and call-binding keys (ADR-0010, ADR-0015): two separate families, never the same
# material. Each key is 32 random bytes, base64url. Generate with:
#   python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
TETHER_AUDIT_ACTIVE_KEY_ID=DEV1
TETHER_AUDIT_KEY_DEV1=change-me
TETHER_BINDING_ACTIVE_KEY_ID=DEV1
TETHER_BINDING_KEY_DEV1=change-me

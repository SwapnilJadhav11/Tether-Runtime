# Normalise line endings: LF in the repository and working tree on every platform, so the
# Windows development host and Linux CI/containers see identical files (scripts, YAML, lockfile).
* text=auto eol=lf

# Windows-native scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
